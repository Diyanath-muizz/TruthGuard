# ─────────────────────────────────────────────────────────────────────────────
# TruthGuard – Environment Configuration Template
# Copy this file to .env and fill in real values. Never commit .env to VCS.
# ─────────────────────────────────────────────────────────────────────────────

# ── LLM Provider ─────────────────────────────────────────────────────────────
# Supported values: openai | groq | ollama | mock
LLM_PROVIDER=mock

# ── OpenAI ───────────────────────────────────────────────────────────────────
OPENAI_API_KEY=sk-replace-with-your-openai-api-key
OPENAI_MODEL=gpt-4o-mini

# ── Groq ─────────────────────────────────────────────────────────────────────
GROQ_API_KEY=gsk_replace-with-your-groq-api-key
GROQ_MODEL=llama3-70b-8192

# ── Ollama (local) ───────────────────────────────────────────────────────────
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3

# ── Embeddings ───────────────────────────────────────────────────────────────
# HuggingFace sentence-transformers model name or path
EMBEDDING_MODEL=all-MiniLM-L6-v2

# ── Vector Store ─────────────────────────────────────────────────────────────
# Directory where ChromaDB persists its data
CHROMA_PERSIST_DIR=data/chroma

# ── Relational Database ───────────────────────────────────────────────────────
# SQLite path (relative to project root)
SQLITE_DB_PATH=data/truthguard.db

# ── Ingestion Limits ─────────────────────────────────────────────────────────
MAX_FILE_SIZE_MB=50

# ── Agent Loop ────────────────────────────────────────────────────────────────
# Maximum critic–revise iterations before escalating to human review
MAX_REVISIONS=2

# ── Logging ──────────────────────────────────────────────────────────────────
# Standard Python log levels: DEBUG | INFO | WARNING | ERROR | CRITICAL
LOG_LEVEL=INFO

# ── Local Admin Auth ─────────────────────────────────────────────────────────
# Simple password protecting the admin / conflict-resolution UI panel
ADMIN_PASSWORD=changeme
