{
  "benchmark_name": "TruthGuard Gold-Standard Evaluation Corpus",
  "version": "1.0",
  "total_cases": 40,
  "test_cases": [
    {
      "id": "TC001",
      "category": "superseded_amendment",
      "question": "How many days of annual leave are employees entitled to?",
      "relevant_docs": ["leave_amendment_2025.txt", "leave_policy_2024.txt", "leave_faq_2024.txt"],
      "expected_status": "verified",
      "expected_answer_contains": ["15 days", "2025 amendment"],
      "expected_answer_excludes": ["12 to 15", "approximately"],
      "expected_authoritative_doc": "leave_amendment_2025.txt",
      "expected_citation_includes": ["leave_amendment_2025.txt"],
      "expected_outdated_docs": ["leave_policy_2024.txt", "leave_faq_2024.txt"],
      "expected_conflict_type": "superseded_amendment",
      "expected_escalation": false,
      "notes": "Amendment explicitly supersedes 2024 policy. Must state 15 days."
    },
    {
      "id": "TC002",
      "category": "equal_authority_conflict",
      "question": "How many days per week are Engineering employees permitted to work remotely?",
      "relevant_docs": ["remote_work_policy_a.txt", "remote_work_policy_b.txt"],
      "expected_status": "human_review_required",
      "expected_answer_contains": ["Policy A", "Policy B", "abstain"],
      "expected_authoritative_doc": null,
      "expected_citation_includes": ["remote_work_policy_a.txt", "remote_work_policy_b.txt"],
      "expected_conflict_type": "numerical",
      "expected_escalation": true,
      "notes": "Equal authority conflicting policies (2 days vs 3 days). Must escalate."
    },
